cc_binary {
    name: "android.hardware.thermal-service.oplus",
    relative_install_path: "hw",
    init_rc: ["android.hardware.thermal-service.oplus.rc"],
    vintf_fragments: ["android.hardware.thermal-service.oplus.xml"],
    vendor: true,

    srcs: [
        "Thermal.cpp",
        "service.cpp",
    ],

    shared_libs: [
        "android.hardware.thermal-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],
}
